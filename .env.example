# --- graph: leave these commented out to use the built-in in-memory graph (recommended to start) ---
#NEO4J_URI=bolt://localhost:7687          # local Docker;  AuraDB looks like neo4j+s://<id>.databases.neo4j.io
#NEO4J_USER=neo4j
#NEO4J_PASSWORD=insurance123

# --- LLM: pick ONE option, leave the rest blank. With none set, a no-model extractive fallback is used. ---
# Option A (free, local): Ollama  ->  install from ollama.com, then `ollama pull llama3.1:8b`
#FIA_LLM_BASE_URL=http://localhost:11434/v1
#FIA_LLM_API_KEY=ollama
#FIA_LLM_MODEL=llama3.1:8b
# Option B (free tier): Groq / Gemini / OpenRouter - any OpenAI-compatible endpoint, e.g. Groq:
#FIA_LLM_BASE_URL=https://api.groq.com/openai/v1
#FIA_LLM_API_KEY=your_key_here
#FIA_LLM_MODEL=llama-3.3-70b-versatile
# Option C (paid): Claude
#ANTHROPIC_API_KEY=
#FIA_LLM_MODEL=claude-sonnet-5-5

# --- retrieval ---
FIA_EMBED_MODEL=BAAI/bge-small-en-v1.5
FIA_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- governance ---
FIA_CONFIDENCE_THRESHOLD=0.7
FIA_AMOUNT_THRESHOLD_INR=100000

# --- access control for the web app (REQUIRED on any public deployment; Render generates these for you) ---
FIA_ACCESS_KEY=change-me-long-random
FIA_REVIEWER_KEY=change-me-too-long-random

# --- production model profile (no PyTorch). For local dev with sentence-transformers: FIA_EMBEDDER=st FIA_RERANKER=cross ---
#FIA_EMBEDDER=fastembed
#FIA_RERANKER=fastembed
